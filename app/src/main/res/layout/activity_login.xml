<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".views.LoginActivity">

    <!-- App Branding -->
    <ImageView
        android:id="@+id/logoImage"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginTop="60dp"
        android:src="@mipmap/ic_launcher"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/signInText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="sans-serif-black"
        android:letterSpacing="-0.02"
        android:text="Sign In"
        android:textColor="@color/strokeColor"
        android:textSize="36sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/logoImage" />

    <TextView
        android:id="@+id/welcomeSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="sans-serif-medium"
        android:text="Welcome back!"
        android:textColor="#7C7C7C"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/signInText" />


    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cvEmail"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="24dp"
        android:backgroundTint="@color/white"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/welcomeSubtitle"
        app:strokeColor="@color/strokeColor"
        app:strokeWidth="1dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/ivEmailIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="20dp"
                android:src="@drawable/mail"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/strokeColor" />

            <EditText
                android:id="@+id/cvEmailTextField"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="12dp"
                android:background="@null"
                android:fontFamily="sans-serif-medium"
                android:hint="Email"
                android:inputType="textEmailAddress"
                android:textColor="@color/textColor"
                android:textColorHint="#ADB5BD"
                android:textSize="16sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/ivEmailIcon" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>


    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cvPassword"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="20dp"
        android:backgroundTint="@color/white"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cvEmail"
        app:strokeColor="@color/strokeColor"
        app:strokeWidth="1dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/ivPassIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="20dp"
                android:src="@drawable/group"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/strokeColor" />

            <EditText
                android:id="@+id/cvPasswordTextField"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="12dp"
                android:background="@null"
                android:fontFamily="sans-serif-medium"
                android:hint="Password"
                android:inputType="textPassword"
                android:textColor="@color/textColor"
                android:textColorHint="#ADB5BD"
                android:textSize="16sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/ivPassIcon" />
        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>


    <TextView
        android:id="@+id/forgotPasswordLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Forgot Password?"
        android:textColor="@color/strokeColor"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="@id/cvPassword"
        app:layout_constraintTop_toBottomOf="@+id/cvPassword" />

    <TextView
        android:id="@+id/orLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:text="OR"
        android:textColor="#7C7C7C"
        android:textSize="18sp"
        android:fontFamily="sans-serif-medium"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/signInButton" />

    <com.google.android.material.divider.MaterialDivider
        android:id="@+id/firstDiv"
        android:layout_width="106dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="10dp"
        app:dividerColor="#DDE1E6"
        app:layout_constraintBottom_toBottomOf="@id/orLabel"
        app:layout_constraintEnd_toStartOf="@id/orLabel"
        app:layout_constraintTop_toTopOf="@id/orLabel" />

    <com.google.android.material.divider.MaterialDivider
        android:id="@+id/secondDiv"
        android:layout_width="106dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        app:dividerColor="#DDE1E6"
        app:layout_constraintBottom_toBottomOf="@id/orLabel"
        app:layout_constraintStart_toEndOf="@id/orLabel"
        app:layout_constraintTop_toTopOf="@id/orLabel" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/signInButton"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:layout_marginTop="32dp"
        android:background="@drawable/btn_gradient"
        android:elevation="4dp"
        android:fontFamily="sans-serif-medium"
        android:paddingHorizontal="30dp"
        android:paddingVertical="10dp"
        android:text="Sign In"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="20sp"
        app:backgroundTint="@null"
        app:cornerRadius="16dp"
        app:layout_constraintEnd_toEndOf="@id/cvPassword"
        app:layout_constraintStart_toStartOf="@id/cvPassword"
        app:layout_constraintTop_toBottomOf="@+id/forgotPasswordLabel" />

    <!-- Professional Google Button Background -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/googleButtonCard"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="24dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#FFFFFF"
        app:strokeColor="#DDE1E6"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toBottomOf="@id/orLabel" />

    <!-- Google Icon -->
    <ImageView
        android:id="@+id/ivGoogleIcon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/google"
        app:layout_constraintBottom_toBottomOf="@id/googleButtonCard"
        app:layout_constraintEnd_toStartOf="@id/tvContinueWithGoogle"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="@id/googleButtonCard"
        app:layout_constraintTop_toTopOf="@id/googleButtonCard" />

    <!-- Google Text -->
    <TextView
        android:id="@+id/tvContinueWithGoogle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:text="Continue with Google"
        android:textColor="#3C4043"
        android:textSize="16sp"
        android:fontFamily="sans-serif-medium"
        app:layout_constraintBottom_toBottomOf="@id/googleButtonCard"
        app:layout_constraintEnd_toEndOf="@id/googleButtonCard"
        app:layout_constraintStart_toEndOf="@id/ivGoogleIcon"
        app:layout_constraintTop_toTopOf="@id/googleButtonCard" />

    <!-- Clickable Overlay (Keeps your backend working) -->
    <ImageView
        android:id="@+id/signInGoogle"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintBottom_toBottomOf="@id/googleButtonCard"
        app:layout_constraintEnd_toEndOf="@id/googleButtonCard"
        app:layout_constraintStart_toStartOf="@id/googleButtonCard"
        app:layout_constraintTop_toTopOf="@id/googleButtonCard" />

    <TextView
        android:id="@+id/dontHaveText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:text="Don't have an account?"
        android:textColor="#7C7C7C"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="@id/firstDiv"
        app:layout_constraintTop_toBottomOf="@+id/signInGoogle" />

    <TextView
        android:id="@+id/SignUPText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="5dp"
        android:layout_marginTop="30dp"
        android:text="Sign Up"
        android:textColor="@color/strokeColor"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="@+id/secondDiv"
        app:layout_constraintStart_toEndOf="@+id/dontHaveText"
        app:layout_constraintTop_toBottomOf="@+id/signInGoogle"

        />
</androidx.constraintlayout.widget.ConstraintLayout>


