<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".views.ForgotScreen">

    <!-- Header Action Bar -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cvCard"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:backgroundTint="@color/viewColor"
        app:cardCornerRadius="0dp"
        app:cardElevation="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/goBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="16dp"
            android:padding="8dp"
            android:src="@drawable/ic_back"
            app:tint="@color/strokeColor" />

    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/forgotPassLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="32dp"
        android:fontFamily="sans-serif-black"
        android:letterSpacing="-0.02"
        android:text="Forgot Password"
        android:textColor="@color/strokeColor"
        android:textSize="36sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cvCard" />

    <TextView
        android:id="@+id/otpText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="40dp"
        android:alpha="0.8"
        android:fontFamily="sans-serif-medium"
        android:text="Please enter your email. You will receive a link to create a new password."
        android:textColor="@color/textColor"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/forgotPassLabel"
        app:layout_constraintTop_toBottomOf="@+id/forgotPassLabel" />

    <!-- Email Field (Standardized Design) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/emailEditTextView"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="40dp"
        android:backgroundTint="@color/white"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp"
        app:layout_constraintTop_toBottomOf="@id/otpText"
        app:strokeColor="@color/strokeColor"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivEmailIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="20dp"
                android:src="@drawable/mail"
                app:tint="@color/strokeColor" />

            <EditText
                android:id="@+id/forgotEmailEditText"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="12dp"
                android:background="@null"
                android:fontFamily="sans-serif-medium"
                android:hint="Email Address"
                android:inputType="textEmailAddress"
                android:paddingEnd="20dp"
                android:textColor="@color/textColor"
                android:textColorHint="#ADB5BD"
                android:textSize="16sp" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/sendResetLink"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:layout_marginTop="48dp"
        android:background="@drawable/btn_gradient"
        android:elevation="4dp"
        android:fontFamily="sans-serif-medium"
        android:paddingHorizontal="30dp"
        android:paddingVertical="10dp"
        android:text="Send Reset Link"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="20sp"
        app:backgroundTint="@null"
        app:cornerRadius="16dp"
        app:layout_constraintEnd_toEndOf="@id/emailEditTextView"
        app:layout_constraintStart_toStartOf="@id/emailEditTextView"
        app:layout_constraintTop_toBottomOf="@+id/emailEditTextView" />

</androidx.constraintlayout.widget.ConstraintLayout>